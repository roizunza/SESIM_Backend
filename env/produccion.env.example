# AMBIENTE: PRODUCCION -- servidor de produccion; sin cuentas de prueba, sin Mailpit
# Copiar a .env en la raiz de Back (o dejar que ./scripts/generar-claves.sh
# produccion lo haga) y ajustar. El .env real nunca se sube al repositorio.
# Un ambiente por maquina: ver docs/ambientes.md.
#
# Generar POSTGRES_PASSWORD, JWT_SECRET, ANON_KEY, SERVICE_ROLE_KEY,
# DASHBOARD_PASSWORD y PG_META_CRYPTO_KEY con:
#   ./scripts/generar-claves.sh produccion
# Cada ambiente usa claves DISTINTAS: un token de pruebas jamas debe servir
# en produccion.

############
# Ambiente (Ciclo 2)
############
APP_ENV=produccion
# Postgres y servicio de procesos solo en el propio servidor; hacia afuera
# solo sale el gateway por HTTPS (proxy inverso del servidor).
DB_BIND_ADDR=127.0.0.1
PROCESOS_BIND_ADDR=127.0.0.1
PROCESOS_PORT=8001

############
# Postgres
############
POSTGRES_PASSWORD=cambia_esto_con_generar-claves.sh
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

############
# JWT / API keys (generar con ./scripts/generar-claves.sh)
############
JWT_SECRET=cambia_esto_con_generar-claves.sh
JWT_EXPIRY=3600
ANON_KEY=cambia_esto_con_generar-claves.sh
SERVICE_ROLE_KEY=cambia_esto_con_generar-claves.sh

############
# URLs (desarrollo local; ajustar cuando haya dominio real)
############
API_GW_HTTP_PORT=8000
SUPABASE_PUBLIC_URL=https://sesim.cambia_esto.gob.mx
API_EXTERNAL_URL=https://sesim.cambia_esto.gob.mx/auth/v1
SITE_URL=https://sesim.cambia_esto.gob.mx
ADDITIONAL_REDIRECT_URLS=

############
# PostgREST: agrega "api" (el esquema propio de SESIM) al default de Supabase.
############
PGRST_DB_SCHEMAS=api,public,graphql_public

############
# Auth (GoTrue)
############
DISABLE_SIGNUP=true
# Nadie se auto-registra: toda cuenta se crea via servicio-procesos
# (POST /admin/alta-usuario, solo administrador_titular -- ver README.md).
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

############
# Correo -- SMTP institucional (obligatorio en produccion; no hay Mailpit).
# Si SEDUMOP no entrega SMTP, GoTrue no podra enviar correos: el
# restablecimiento de contrasena lo genera entonces el Administrador Titular
# y lo entrega por canal institucional (alcances, Ciclo 1). Dejar SMTP_HOST
# vacio NO desactiva el correo (el compose cae a mailpit, que en produccion
# no existe): decidirlo y documentarlo antes de salir a produccion.
############
SMTP_HOST=cambia_esto_smtp.institucional
SMTP_PORT=587
SMTP_USER=cambia_esto
SMTP_PASS=cambia_esto
SMTP_ADMIN_EMAIL=cambia_esto@dominio.gob.mx
SMTP_SENDER_NAME=SESIM

############
# Studio (panel de administracion visual de Supabase)
############
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=cambia_esto_dashboard
STUDIO_DEFAULT_ORGANIZATION=SEDUMOP
STUDIO_DEFAULT_PROJECT=SESIM
PG_META_CRYPTO_KEY=cambia_esto_32_caracteres_minimo
