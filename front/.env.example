# Conexion del front con el backend SESIM. Copie a .env.local (o corra scripts/configurar-env.sh).
# El navegador habla con el servidor de Vite y este reenvia al backend (ver vite.config.js).
VITE_SUPABASE_URL=/supabase
VITE_SUPABASE_ANON_KEY=pegue_aqui_el_ANON_KEY_del_.env_del_backend
VITE_PROCESOS_URL=/procesos
# Destinos del proxy de desarrollo (opcionales; estos son los valores por omision)
# SESIM_GATEWAY=http://localhost:8000
# SESIM_PROCESOS=http://localhost:8001
