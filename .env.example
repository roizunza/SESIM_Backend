# Copiar a .env y ajustar antes de levantar el entorno (nunca se sube el
# .env real al repositorio -- ver .gitignore).
#
# Este .env es compartido entre infra/supabase/docker-compose.yml y
# docker-compose.sesim.yml (ver scripts/levantar.sh: se pasa con
# --env-file .env a ambos a la vez). Trae SOLO las variables que hacen
# falta para los servicios que de verdad se levantan en Ciclo 1: db, auth,
# rest, api-gw (gateway), studio, meta, servicio-procesos, mailpit (ver
# scripts/levantar.sh). NO estan aqui las variables de realtime/storage/
# imgproxy/functions/supavisor porque esos servicios no se levantan --
# apareceran warnings de "variable is not set" al correr docker compose,
# son normales e inofensivos (ver README.md).
#
# Generar POSTGRES_PASSWORD, JWT_SECRET, ANON_KEY y SERVICE_ROLE_KEY con:
#   ./scripts/generar-claves.sh
# (usa el generador oficial de Supabase, infra/supabase/utils/generate-keys.sh)

############
# Postgres
############
POSTGRES_PASSWORD=cambia_esto_con_generar-claves.sh
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

############
# JWT / API keys (generar con ./scripts/generar-claves.sh)
############
JWT_SECRET=cambia_esto_con_generar-claves.sh
JWT_EXPIRY=3600
ANON_KEY=cambia_esto_con_generar-claves.sh
SERVICE_ROLE_KEY=cambia_esto_con_generar-claves.sh

############
# URLs (desarrollo local; ajustar cuando haya dominio real)
############
API_GW_HTTP_PORT=8000
SUPABASE_PUBLIC_URL=http://localhost:8000
API_EXTERNAL_URL=http://localhost:8000/auth/v1
SITE_URL=http://localhost:5173
ADDITIONAL_REDIRECT_URLS=

############
# PostgREST: agrega "api" (el esquema propio de SESIM) al default de Supabase.
############
PGRST_DB_SCHEMAS=api,public,graphql_public

############
# Auth (GoTrue)
############
DISABLE_SIGNUP=true
# Nadie se auto-registra: toda cuenta se crea via servicio-procesos
# (POST /admin/alta-usuario, solo administrador_vip -- ver README.md).
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

############
# Correo -- en desarrollo va a Mailpit (servicio "mailpit" de
# docker-compose.sesim.yml), no a Gmail real (ver
# docs/decisiones-pendientes.md).
############
SMTP_ADMIN_EMAIL=admin@sesim.local
SMTP_SENDER_NAME=SESIM

############
# Studio (panel de administracion visual de Supabase)
############
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=cambia_esto_dashboard
STUDIO_DEFAULT_ORGANIZATION=SEDUMOP
STUDIO_DEFAULT_PROJECT=SESIM
PG_META_CRYPTO_KEY=cambia_esto_32_caracteres_minimo
